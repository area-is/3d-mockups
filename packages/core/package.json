{
  "name": "@area-3d-mockups/core",
  "version": "0.1.0",
  "description": "Framework-agnostic core for area-3d-mockups: device/object specs, geometry math, and the screen & stage behaviors shared by every framework binding.",
  "keywords": [
    "threejs",
    "3d",
    "mockup",
    "device",
    "phone",
    "smartphone",
    "webgl",
    "gpu"
  ],
  "license": "MIT",
  "author": "subwaymatch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/area-is/3d-mockups.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/area-is/3d-mockups#readme",
  "bugs": {
    "url": "https://github.com/area-is/3d-mockups/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "three": ">=0.179.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "three": "^0.185.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
