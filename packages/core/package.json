{
  "name": "@area-3d-mockups/core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic core for area-3d-mockups: device/object specs, geometry math, and the screen & stage behaviors shared by every framework binding. Workspace-only: bundled into area-3d-mockups, never published on its own.",
  "license": "MIT",
  "author": "subwaymatch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/area-is/3d-mockups.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "three": ">=0.179.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.185.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
