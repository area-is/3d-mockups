{
  "name": "area-3d-mockups",
  "version": "0.1.0",
  "description": "Interactive, GPU-accelerated 3D device mockups for React. Drop any content onto the screen of a 3D phone and it stays fully live.",
  "keywords": [
    "react",
    "threejs",
    "react-three-fiber",
    "drei",
    "3d",
    "mockup",
    "device",
    "phone",
    "smartphone",
    "webgl",
    "gpu"
  ],
  "license": "MIT",
  "author": "subwaymatch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/area-is/3d-mockups.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/area-is/3d-mockups#readme",
  "bugs": {
    "url": "https://github.com/area-is/3d-mockups/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./catalog.json": "./dist/catalog.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsup && node scripts/build-catalog.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run clean && tsup && node scripts/build-catalog.mjs",
    "devices:check": "node scripts/sync-device-table.mjs",
    "devices:sync": "node scripts/sync-device-table.mjs --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@react-three/drei": ">=10",
    "@react-three/fiber": ">=9",
    "react": ">=19",
    "react-dom": ">=19",
    "three": ">=0.179.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/three": "^0.185.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.14",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
