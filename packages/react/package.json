{
  "name": "react-3d-mockups",
  "version": "0.1.1",
  "description": "Interactive, GPU-accelerated 3D device mockups for React. Drop any content onto the screen of a 3D phone and it stays fully live.",
  "keywords": [
    "react",
    "threejs",
    "three",
    "react-three-fiber",
    "r3f",
    "drei",
    "3d",
    "webgl",
    "mockup",
    "device-mockup",
    "phone-mockup",
    "iphone-mockup",
    "macbook-mockup",
    "product-mockup",
    "packaging-mockup",
    "billboard-mockup",
    "mockup-generator",
    "device",
    "phone",
    "smartphone"
  ],
  "license": "MIT",
  "author": "Ye Joo Park (https://github.com/subwaymatch)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/area-is/react-3d-mockups.git",
    "directory": "packages/react"
  },
  "homepage": "https://area.is/react-3d-mockups",
  "bugs": {
    "url": "https://github.com/area-is/react-3d-mockups/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./catalog.json": "./dist/catalog.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsup && node scripts/build-catalog.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run clean && tsup && node scripts/build-catalog.mjs",
    "devices:check": "node scripts/sync-device-table.mjs",
    "devices:sync": "node scripts/sync-device-table.mjs --write",
    "size": "node scripts/measure-size.mjs",
    "size:check": "node scripts/measure-size.mjs --check",
    "size:write": "node scripts/measure-size.mjs --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "its-fine": "^2.0.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.7"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.179.0 <0.187.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
