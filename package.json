{
  "name": "react-3d-mockups-monorepo",
  "private": true,
  "description": "Monorepo for react-3d-mockups: interactive, GPU-accelerated 3D device mockups for React. The published package plus its docs site.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w react-3d-mockups && npm run build -w docs",
    "build:pkg": "npm run build -w react-3d-mockups",
    "build:docs": "npm run build -w docs",
    "dev": "concurrently -n pkg,docs -c cyan,magenta \"npm run dev -w react-3d-mockups\" \"npm run dev -w docs\"",
    "start:docs": "npm run start -w docs",
    "preview:docs": "npm run preview -w docs",
    "deploy:docs": "npm run deploy -w docs",
    "typecheck": "npm run typecheck -w react-3d-mockups && npm run typecheck -w docs",
    "test": "npm run test -w react-3d-mockups",
    "visual": "node apps/docs/scripts/visual-check.mjs",
    "bench": "node apps/docs/scripts/bench.mjs",
    "devices:check": "node packages/react/scripts/sync-device-table.mjs && node packages/react/scripts/check-docs-data.mjs",
    "devices:sync": "node packages/react/scripts/sync-device-table.mjs --write && node packages/react/scripts/check-docs-data.mjs --write",
    "size": "npm run size -w react-3d-mockups",
    "size:check": "npm run size:check -w react-3d-mockups",
    "size:write": "npm run size:write -w react-3d-mockups",
    "docs:examples": "node apps/docs/scripts/check-doc-examples.mjs",
    "release": "node packages/react/scripts/release.mjs prepare",
    "release:notes": "node packages/react/scripts/release.mjs notes"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
