{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    // The type-level half of the aliases in remotion.config.ts. The package's
    // typings sit behind the `file:` symlink, so `react` and fiber resolve from
    // the monorepo's node_modules too, and fiber's `<group>`/`<mesh>` JSX
    // elements land on that copy of React's JSX namespace rather than this
    // one. Fiber 9.7 hid this by accident: its `Canvas` return type pulled in
    // `react/jsx-runtime`, which TypeScript then merged into this project's.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@react-three/fiber": ["./node_modules/@react-three/fiber"]
    }
  },
  "include": ["src", "remotion.config.ts"]
}
