{
  "name": "react-3d-mockups-remotion-example",
  "private": true,
  "description": "A Remotion video built from react-3d-mockups scenes over Tabbied pattern backgrounds. Not a workspace: it installs the package the way an app would.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render MockupReel out/mockup-reel.mp4 --concurrency=1",
    "still": "remotion still",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.532",
    "@remotion/transitions": "^4.0.532",
    "react": "19.3.0",
    "react-3d-mockups": "file:../../packages/react",
    "react-dom": "19.3.0",
    "remotion": "4.0.532",
    "tabbied": "0.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "6.0.3"
  }
}
