{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "description": "Docs & demos site for react-3d-mockups.",
  "scripts": {
    "dev": "node scripts/extract-demo-sources.mjs && node scripts/extract-prop-tables.mjs && next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "node scripts/extract-demo-sources.mjs && node scripts/extract-prop-tables.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "visual": "node scripts/visual-check.mjs",
    "bench": "node scripts/bench.mjs",
    "thumbs": "node scripts/generate-thumbs.mjs",
    "features": "node scripts/generate-feature-shots.mjs",
    "example-thumbs": "node scripts/generate-example-thumbs.mjs",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && npx wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "docs:variants": "node scripts/generate-variant-pages.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "fumadocs-core": "^16.15.17",
    "fumadocs-mdx": "^15.4.5",
    "fumadocs-ui": "^16.15.17",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-3d-mockups": "*",
    "react-dom": "^19.3.0",
    "tabbied": "^0.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.145.0"
  }
}
