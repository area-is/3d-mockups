{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "description": "Docs & demos site for area-3d-mockups.",
  "scripts": {
    "dev": "node scripts/extract-demo-sources.mjs && next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "node scripts/extract-demo-sources.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "visual": "node scripts/visual-check.mjs",
    "thumbs": "node scripts/generate-thumbs.mjs",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && npx wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "area-3d-mockups": "*",
    "fumadocs-core": "^16.11.1",
    "fumadocs-mdx": "^15.1.0",
    "fumadocs-ui": "^16.11.1",
    "next": "^16.2.11",
    "postcss": "^8.5.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  }
}
