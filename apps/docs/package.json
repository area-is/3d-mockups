{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "description": "Docs & demos site for area-3d-mockups.",
  "scripts": {
    "dev": "node scripts/extract-demo-sources.mjs && node scripts/extract-prop-tables.mjs && next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "node scripts/extract-demo-sources.mjs && node scripts/extract-prop-tables.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "visual": "node scripts/visual-check.mjs",
    "thumbs": "node scripts/generate-thumbs.mjs",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && npx wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "docs:variants": "node scripts/generate-variant-pages.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "area-3d-mockups": "*",
    "fumadocs-core": "^16.14.1",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-ui": "^16.14.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-simple-typewriter": "^5.0.1",
    "tabbied": "^0.5.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.119.0"
  }
}
