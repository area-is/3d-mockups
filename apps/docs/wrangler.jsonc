{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "area-3d-mockups-docs",
  "main": ".open-next/worker.js",

  // nodejs_compat is required by @opennextjs/cloudflare (the Next server it
  // wraps reaches for node: builtins), and the flag is only honoured from
  // compatibility_date 2024-09-23 onward.
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],

  // Wrangler bundles with esbuild's keep-names on by default, which wraps
  // functions in `__name(...)`. fumadocs' theme script (next-themes) is a
  // function the server stringifies into an inline <script>, so the wrapper
  // went to the browser with it, where no `__name` exists: every docs page
  // threw a ReferenceError before the saved theme was applied, and the theme
  // only landed after hydration. `next start` never bundles with Wrangler,
  // which is why only the deployed Worker showed it. The cost: nothing is
  // minified, but a function esbuild renames to avoid a clash between modules
  // (`foo` -> `foo2`) now reports the new name in stack traces.
  "keep_names": false,

  // Everything Next emits as a static file is served straight off the edge by
  // Workers Assets and never counts against the Worker's own bundle size. That
  // matters here: the mockup scenes are `ssr: false` dynamic imports, so
  // three.js / r3f / drei live entirely in these assets and never enter the
  // Worker.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  /*
   * Served at a path on the apex rather than on its own hostname.
   *
   * A Custom Domain cannot do this - it binds a whole hostname and has no path
   * component - so these are Routes, and they only fire because `area.is` has
   * a PROXIED (orange-cloud) DNS record: a route on a hostname Cloudflare does
   * not terminate never matches, and the symptom is ERR_NAME_NOT_RESOLVED
   * rather than a 404 you could debug.
   *
   * Two patterns, not one `…/react-3d-mockups*`: a single trailing wildcard
   * would also swallow `/react-3d-mockups-anything-else`. The bare pattern
   * catches the index, the `/*` one everything under it.
   *
   * Routes match most-specific-first, so these win over a broader `area.is/*`
   * - and over a Custom Domain or a Pages project on the same hostname - which
   * is what lets the apex app own everything except this path. Whoever sets
   * that app up has to leave these alone and keep the apex record proxied.
   *
   * The prefix is `basePath` in `lib/base-path.mjs`; the two have to agree.
   */
  "routes": [
    { "pattern": "area.is/react-3d-mockups", "zone_name": "area.is" },
    { "pattern": "area.is/react-3d-mockups/*", "zone_name": "area.is" }
  ],

  /*
   * Both halves of the workers.dev subdomain, stated rather than left to
   * default - because the default is derived from `routes` above and is
   * re-applied on EVERY deploy.
   *
   * `wrangler deploy` POSTs this Worker's subdomain state each time it runs.
   * `workers_dev` defaults to `routes.length === 0`, so configuring routes
   * silently resolves it to `false`; and with `preview_urls` absent from this
   * file wrangler sends no value for it, which has the API disable Preview
   * URLs alongside the production hostname. Enabling them in the dashboard
   * therefore lasts exactly until the next Workers Build, which is what makes
   * it look like something is switching itself back off.
   *
   * What we actually want is the mixed state: no production workers.dev
   * hostname, because the site is served at the routes above, but Preview URLs
   * ON - Workers Builds publishes one per commit and
   * `.github/workflows/cloudflare-build-pr-comments.yml` posts it on the pull
   * request, so without them every build comment links nowhere. Wrangler warns
   * about this pair interactively (a Worker with no production URL is still
   * reachable at its preview one - that is the point here); it stays quiet in
   * CI, which is where this deploys from.
   */
  "workers_dev": false,
  "preview_urls": true,

  "observability": {
    "enabled": true
  }
}
